# ==============================================================================
# SMART SCHOOL KZ (MEKTEP HUB) — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Port (Express API)
PORT=5000

# Frontend API URL (leave empty or use /api when using Vite proxy)
VITE_API_URL=http://localhost:5000/api

# Optional: Gemini API key for live LLM generation (fallback solver is active by default)
GEMINI_API_KEY=

# Node Environment
NODE_ENV=development
