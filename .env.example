# ==============================================================================
# SMART SCHOOL KZ (MEKTEP HUB) — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Port (Express API Server)
PORT=5000

# Frontend API URL (for Vite client requests)
VITE_API_URL=http://localhost:5000/api

# ==============================================================================
# AI API KEYS (Choose either Google Gemini API or OpenAI API)
# Paste your key below to activate live generative AI models.
# If no key is set, the system seamlessly runs high-fidelity academic heuristics.
# ==============================================================================

# Google Gemini API Key (Recommended, supports Gemini 1.5 Flash / 2.0)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# Or OpenAI API Key (gpt-4o-mini)
# OPENAI_API_KEY=sk-...

# Node Environment
NODE_ENV=development
